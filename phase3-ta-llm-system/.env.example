# ── Required security + embedding API ──────────────────────────────────────
TA_CHAT_PASSWORD=change-me                  # shared access password (only enforced if features.auth_required = true)
JWT_SECRET=change-me-random-string          # session signing key — set to a long random string
OPENAI_API_KEY=replace-with-openai-key      # always required for embeddings: vector build + each retrieval query

# ── Project identity ───────────────────────────────────────────────────────
COURSE_ID=your-project-id                   # short identifier; used as Netlify Blob namespace

# ── TA chat/query LLM provider — pick ONE block ────────────────────────────
# This is separate from OPENAI_API_KEY above unless you choose OpenAI direct.
# Phase 2 quiz generation/verification can use agent subscriptions instead.

# Option 1: Mistral (default — Mistral Medium 3)
MISTRAL_API_KEY=replace-with-mistral-key
# LLM_BASE_URL=https://api.mistral.ai/v1    # default, can omit
# MODEL_ID=mistral-medium-latest            # default, can omit

# Option 2: Anthropic Claude
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=replace-with-anthropic-key
# MODEL_ID=claude-haiku-4-5-20251001

# Option 3: OpenAI direct
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=replace-with-openai-key
# MODEL_ID=gpt-4o-mini

# Option 4: Groq (Meta Llama)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=replace-with-groq-key
# MODEL_ID=llama-3.3-70b-versatile

# ── Optional overrides (defaults shown) ────────────────────────────────────
# DAILY_BUDGET_USD=10
# MAX_MESSAGES_PER_SESSION=50
# MAX_REQUESTS_PER_MINUTE=5
# MAX_AUTH_ATTEMPTS=5
# AUTH_LOCKOUT_MINUTES=15
ALLOWED_ORIGIN=*                                  # tighten to https://your-site.netlify.app in production; default * allows any origin (logs a startup warning)
# DATA_DIR=./data
# LLM_STREAM_USAGE=on                            # force-on token usage stream for non-default providers
